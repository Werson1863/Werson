# Az oldal éles, kanonikus címe (sitemap, OG, canonical). Pl. https://loopient.hu
NEXT_PUBLIC_SITE_URL=https://loopient.hu

# Resend (https://resend.com) – a kapcsolati űrlap e-mail küldéséhez
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
# Kinek menjen az űrlap tartalma
CONTACT_TO_EMAIL=hello@loopient.hu
# Feladó: Resendben hitelesített domainről (fejlesztéshez: onboarding@resend.dev)
CONTACT_FROM_EMAIL="Loopient weboldal <urlap@loopient.hu>"

# Csak `npm run build:static` esetén: külső végpont, ahová az űrlap POST-ol
# NEXT_PUBLIC_CONTACT_ENDPOINT=https://valami.hu/api/contact
